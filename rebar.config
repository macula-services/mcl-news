%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_news.
%%
%% Sovereign news sensor: polls public RSS/Atom sources and reports each new item as a mesh fact
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so mcl_om wires the mesh and starts NO
    %% reckon-db. Export both callbacks to turn this into a CMD/PRJ service that
    %% owns an event store; mcl_om:boot/1 does the wiring before start/1.
    %%
    %% ⚠ A TWO-PART TILDE FLOATS TO THE NEXT MAJOR. `~> 0.28' was not "0.28.x"
    %% but "any 0.x", so it followed whichever 0.x was newest -- onto macula 14
    %% today, which is fine, and onto whatever a later mcl_om reaches for
    %% tomorrow, which is not guaranteed to be.
    {mcl_om, "~> 0.39"},
    %% THE WIRE, NAMED, so the next mcl_om cannot move it unnoticed: macula 14
    %% is what the live stations speak, 15.0.0-rc is the wire-1.0 island frozen
    %% until 16 Oct, and naming both makes a mcl_om that reaches for macula 15
    %% clash here at resolve time instead of drifting onto it. Same line, and
    %% the same reason, as mcl-echo (its canary for the wire) and the rest.
    {macula, "~> 14.2"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% macula reaches this app only through mcl_om, so rebar3 leaves it out of the
%% PLT. Name it, so calls into macula are checked rather than excused.
{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [macula, mcl_om]}
]}.

{relx, [
    {release, {mcl_news, "0.1.1"}, [mcl_news, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
