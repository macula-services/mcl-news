%% -*- mode: erlang -*-
%% rebar3 configuration for mcl_news.
%%
%% Sovereign news sensor: polls public RSS/Atom sources and reports each new item as a mesh fact
%%
%% Generated by `rebar3 new mcl_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so mcl_om wires the mesh and starts NO
    %% reckon-db. Export both callbacks to turn this into a CMD/PRJ service that
    %% owns an event store; mcl_om:boot/1 does the wiring before start/1.
    %%
    %% ⚠ A TWO-PART TILDE FLOATS TO THE NEXT MAJOR. `~> 1.0' is not "1.0.x" but
    %% "any 1.x", so it will follow whichever 1.x is newest. 1.0 was mcl_om on
    %% macula 15 (the flag day, macula-fleet#27); the floor is now 1.6, whose own
    %% base is macula 18 (mcl-om#41), because `~> 1.0' also admits 1.3.0, which
    %% requires macula `~> 15.6' (macula-codebase-checks#14).
    %% Every service floated `~> 0.x', which takes any 0.x, so a 0.43 on macula
    %% 15 would have rolled the live 0.10.3 fleet on its next build.
    %%
    %% mcl_om 1.6 refuses to boot a handler-bearing capability that names no
    %% `auth' and a subscription that names no `sources' (macula#147,
    %% macula-io/macula). This service declares neither -- capabilities/0 is []
    %% and there is no subscriptions/0 -- so the rule asks nothing of it.
    {mcl_om, "~> 1.6"},
    %% THE WIRE, NAMED, so the next mcl_om cannot move it unnoticed: 18.0 keeps
    %% wire 1.0, and naming it makes a mcl_om that reaches for another wire clash
    %% here at resolve time instead of drifting onto it. What 18.0 adds is the
    %% caller class and the subscriber's source rule (macula#147), neither of
    %% which this service exercises.
    {macula, "~> 18.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        mcl_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => mcl_min}
    ]}
]}.

{eunit_opts, [verbose]}.

%% macula reaches this app only through mcl_om, so rebar3 leaves it out of the
%% PLT. Name it, so calls into macula are checked rather than excused.
{dialyzer, [
    {warnings, [unknown]},
    {plt_extra_apps, [macula, mcl_om]}
]}.

{relx, [
    {release, {mcl_news, "0.3.0"}, [mcl_news, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
